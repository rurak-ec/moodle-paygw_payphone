{{!
    @template paygw_payphone/payphone_button_placeholder

    Loading placeholder shown while the browser is redirected to PayPhone.

    Context variables required for this template:
    * none

    Example context (json):
    {}
}}
<div class="text-center p-3">
    <div class="spinner-border" role="status">
        <span class="sr-only visually-hidden">{{#str}}redirecting, paygw_payphone{{/str}}</span>
    </div>
    <p class="mt-3 mb-0">{{#str}}redirecting, paygw_payphone{{/str}}</p>
</div>
